# App
APP_NAME=AgentFlow Multi-Agent Suite
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database
# For local dev (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./agentflow.db
# For production (Postgres)
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/agentflow

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=AgentFlow

# Browser
BROWSER_HEADLESS=false
BROWSER_VIEWPORT_WIDTH=1280
BROWSER_VIEWPORT_HEIGHT=720
CDP_SCREENCAST_QUALITY=70
CDP_SCREENCAST_MAX_FPS=12

# Orchestration
AUTO_TAKEOVER_ON_POST_LOGIN=true
PAUSE_ON_CAPTCHA=true
CONFIRM_BEFORE_SUBMIT=true
MAX_AGENT_REVISIONS=3
APPROVAL_THRESHOLD=70

# Auth (placeholder)
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
